<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Inject a location picker into the shared address form fields template.
        `portal.address_form_fields` is reused by both the portal
        /my/account form and the eCommerce /shop/address form, so a single
        inheritance covers both pages.

        The two coordinate inputs are required, so the customer cannot submit
        the address without a location (needed to price distance-based
        delivery). They are auto-filled by the interactive OpenStreetMap map.

        Anchored after `div_state` so the map is the last field on the form,
        below City / Country / National Address / State.
    -->
    <template id="address_form_delivery_location"
              inherit_id="portal.address_form_fields"
              name="Delivery Location Picker">
        <xpath expr="//div[@id='div_state']" position="after">
            <div id="div_delivery_location" class="col-12 mb-2 o_delivery_location">
                <label class="col-form-label">Delivery Location</label>
                <div class="o_delivery_location_search input-group mb-2">
                    <input type="text"
                           id="delivery_location_search"
                           class="form-control"
                           placeholder="Search an address..."/>
                    <button type="button"
                            id="delivery_location_search_btn"
                            class="btn btn-secondary">
                        <i class="fa fa-search"/> Search
                    </button>
                </div>
                <div id="delivery_location_results"
                     class="o_delivery_location_results list-group position-absolute shadow"/>
                <button type="button"
                        id="delivery_location_pin_me"
                        class="btn btn-outline-primary btn-sm mb-2">
                    <i class="fa fa-location-arrow"/> حدد موقعي الحالي
                </button>
                <div id="delivery_location_map" class="o_osm_map_canvas mb-2"/>
                <input type="hidden"
                       name="partner_latitude"
                       id="partner_latitude"
                       t-att-value="partner_sudo.partner_latitude or ''"/>
                <input type="hidden"
                       name="partner_longitude"
                       id="partner_longitude"
                       t-att-value="partner_sudo.partner_longitude or ''"/>
            </div>
        </xpath>
    </template>

    <!--
        Slim down the shared address form so both the portal /my/account form
        and the eCommerce /shop/address form show the same, minimal set of
        fields. Because `portal.address_form_fields` is reused by both pages
        (the shop page via the primary `website_sale.address_form_fields`),
        this single inheritance covers both.

        The unwanted fields (Street and Number, Apartment/suite, Zip Code,
        Company Name, VAT) are NOT removed from the DOM — other modules inherit
        this template and target those inputs by xpath (e.g.
        website_sale_autocomplete patches `input[name='street']`), so deleting
        them breaks view resolution. Instead they are hidden via CSS with
        `!important` (see national_address_field/static/src/scss/national_address.scss),
        which also prevents Odoo's address JS from re-showing them on country
        change.

        This lives here (rather than in national_address_field, which owns
        the National Address field it also reorders) because it needs both
        `div_national_address` (national_address_field) and
        `div_delivery_location` (this module, above) to already exist when it
        runs. delivery_distance depends on national_address_field, so it's
        the only one of the two guaranteed to load after both fields exist.

        Hidden fields collapse, so the visible order is simply the DOM order of
        the remaining fields: City -> Country -> National Address -> State -> Map.
    -->
    <template id="address_form_clean_fields"
              inherit_id="portal.address_form_fields"
              priority="99"
              name="Slim Address Form">
        <!-- Give City a half-width column so it pairs neatly on a row. -->
        <xpath expr="//div[@id='div_city']" position="attributes">
            <attribute name="class">col-lg-6 mb-2</attribute>
        </xpath>
        <!--
            Reorder the visible location fields to:
                Country -> State -> City -> National Address -> Map
            (which reads, with this DB's labels, as
                الدولة -> المدينة -> الحي -> العنوان الوطني -> الخريطة).

            priority="99" makes this the last inheritance applied, so the
            National Address (injected after Country by national_address_field)
            and the Map (injected after State, above) already exist and can be
            moved. The moved elements are inserted, in listed order, right
            after Country.
        -->
        <xpath expr="//div[@id='div_country']" position="after">
            <xpath expr="//div[@id='div_state']" position="move"/>
            <xpath expr="//div[@id='div_city']" position="move"/>
            <xpath expr="//div[@id='div_national_address']" position="move"/>
            <xpath expr="//div[@id='div_delivery_location']" position="move"/>
        </xpath>
    </template>

</odoo>
