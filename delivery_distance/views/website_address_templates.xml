<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="address_form_delivery_location"
              inherit_id="portal.address_form_fields"
              name="Delivery Location Picker">
        <xpath expr="//div[@id='div_state']" position="after">
            <div id="div_delivery_location" class="col-12 mb-2 o_delivery_location">
                <label class="col-form-label">Delivery Location</label>
                <div class="o_delivery_location_search input-group mb-2">
                    <input type="text"
                           id="delivery_location_search"
                           class="form-control"
                           placeholder="Search an address..."/>
                    <button type="button"
                            id="delivery_location_search_btn"
                            class="btn btn-secondary">
                        <i class="fa fa-search"/> Search
                    </button>
                </div>
                <div id="delivery_location_results"
                     class="o_delivery_location_results list-group position-absolute shadow"/>
                <button type="button"
                        id="delivery_location_pin_me"
                        class="btn btn-outline-primary btn-sm mb-2">
                    <i class="fa fa-location-arrow"/> حدد موقعي الحالي
                </button>
                <div id="delivery_location_map" class="o_osm_map_canvas mb-2"/>
                <input type="hidden"
                       name="partner_latitude"
                       id="partner_latitude"
                       t-att-value="partner_sudo.partner_latitude or ''"/>
                <input type="hidden"
                       name="partner_longitude"
                       id="partner_longitude"
                       t-att-value="partner_sudo.partner_longitude or ''"/>
            </div>
        </xpath>
    </template>
    <template id="address_form_clean_fields"
              inherit_id="portal.address_form_fields"
              priority="99"
              name="Slim Address Form">
        <xpath expr="//div[@id='div_country']" position="before">
            <div id="div_address_section_heading" class="col-12 mt-3 mb-2">
                <h5 class="mb-0 pb-2 border-bottom">تفاصيل العنوان</h5>
            </div>
        </xpath>
        <!-- Give City a half-width column so it pairs neatly on a row. -->
        <xpath expr="//div[@id='div_city']" position="attributes">
            <attribute name="class">col-lg-6 mb-2</attribute>
        </xpath>
        <xpath expr="//div[@id='div_country']" position="after">
            <xpath expr="//div[@id='div_state']" position="move"/>
            <xpath expr="//div[@id='div_city']" position="move"/>
            <xpath expr="//div[@id='div_national_address']" position="move"/>
            <xpath expr="//div[@id='div_delivery_location']" position="move"/>
        </xpath>
    </template>

</odoo>
