<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_distance_location" model="ir.ui.view">
        <field name="name">res.company.form.distance.location</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Store Location (OpenStreetMap)" name="distance_location">
                    <group>
                        <field name="partner_latitude"/>
                        <field name="partner_longitude"/>
                    </group>
                    <group>
                        <button name="action_geo_localize_company"
                                type="object"
                                string="Locate from Address"
                                icon="fa-map-marker"
                                class="btn-primary"/>
                    </group>
                    <group colspan="2">
                        <widget name="osm_map_location"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
