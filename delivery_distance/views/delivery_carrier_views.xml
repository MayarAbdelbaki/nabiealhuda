<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_distance" model="ir.ui.view">
        <field name="name">delivery.carrier.form.distance</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Distance Pricing"
                      name="distance_pricing"
                      invisible="delivery_type != 'distance_based'">
                    <group>
                        <group>
                            <field name="distance_origin_partner_id"/>
                            <field name="osrm_base_url"
                                   placeholder="https://router.project-osrm.org"/>
                        </group>
                        <group>
                            <field name="distance_fallback_price"/>
                        </group>
                    </group>
                    <field name="rule_ids">
                        <list string="Pricing Rules" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="country_id"/>
                            <field name="block_km"/>
                            <field name="price_per_block"/>
                            <field name="max_distance_km"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
