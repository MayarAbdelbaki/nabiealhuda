<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="msegat_otp_view_list" model="ir.ui.view">
        <field name="name">msegat.otp.list</field>
        <field name="model">msegat.otp</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date" string="Sent On"/>
                <field name="user_id"/>
                <field name="number"/>
                <field name="method"/>
                <field name="ip"/>
                <field name="attempts"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'verified'" decoration-danger="state == 'failed'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="msegat_otp_view_search" model="ir.ui.view">
        <field name="name">msegat.otp.search</field>
        <field name="model">msegat.otp</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="number"/>
                <field name="ip"/>
                <filter name="verified" string="Verified" domain="[('state', '=', 'verified')]"/>
                <filter name="failed" string="Too Many Attempts" domain="[('state', '=', 'failed')]"/>
                <group>
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="msegat_otp_action" model="ir.actions.act_window">
        <field name="name">Verification Codes</field>
        <field name="res_model">msegat.otp</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No verification code sent yet</p>
            <p>Codes sent by SMS to verify the phone of new external users appear here.</p>
        </field>
    </record>
</odoo>
