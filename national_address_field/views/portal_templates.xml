<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Inject the national address field into the shared address form fields
        template. This template (`portal.address_form_fields`) is reused by
        both the portal /my/account form (portal.portal_my_details) and the
        eCommerce /shop/address form (website_sale.address), so a single
        inheritance covers both pages.

        The field div is hidden by default and revealed by JavaScript only when
        the selected country is Saudi Arabia (ISO code "SA").
    -->
    <template id="address_form_national_address"
              inherit_id="portal.address_form_fields"
              name="National Address Field">
        <xpath expr="//div[@id='div_country']" position="after">
            <div id="div_national_address"
                 class="col-lg-6 mb-2 o_national_address_field"
                 style="display: none;">
                <label class="col-form-label" for="o_x_national_address">
                    العنوان الوطني
                </label>
                <input type="text"
                       name="x_national_address"
                       id="o_x_national_address"
                       class="form-control"
                       t-att-value="partner_sudo.x_national_address"/>
            </div>
        </xpath>
    </template>

    <!--
        Slim down the shared address form so both the portal /my/account form
        and the eCommerce /shop/address form show the same, minimal set of
        fields. Because `portal.address_form_fields` is reused by both pages
        (the shop page via the primary `website_sale.address_form_fields`),
        this single inheritance covers both.

        The unwanted fields (Street and Number, Apartment/suite, Zip Code,
        Company Name, VAT) are NOT removed from the DOM — other modules inherit
        this template and target those inputs by xpath (e.g.
        website_sale_autocomplete patches `input[name='street']`), so deleting
        them breaks view resolution. Instead they are hidden via CSS with
        `!important` (see static/src/scss/national_address.scss), which also
        prevents Odoo's address JS from re-showing them on country change.

        Hidden fields collapse, so the visible order is simply the DOM order of
        the remaining fields: City -> Country -> National Address -> State -> Map
        (National Address is injected after Country above; the Map is injected
        after State by the delivery_distance module).
    -->
    <template id="address_form_clean_fields"
              inherit_id="portal.address_form_fields"
              name="Slim Address Form">
        <!-- City now leads the location fields; give it the same half width as
             Country/State for a tidy layout. -->
        <xpath expr="//div[@id='div_city']" position="attributes">
            <attribute name="class">col-lg-6 mb-2</attribute>
        </xpath>
    </template>

</odoo>
