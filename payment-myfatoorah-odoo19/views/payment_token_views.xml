<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_token_form_myfatoorah" model="ir.ui.view">
        <field name="name">payment.token.form.myfatoorah</field>
        <field name="model">payment.token</field>
        <field name="inherit_id" ref="payment.payment_token_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group string="KFast Card Details"
                       attrs="{'invisible': [('provider_id.code', '!=', 'myfatoorah')]}">
                    <field name="myfatoorah_card_brand" readonly="1"/>
                    <field name="myfatoorah_card_last4" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
