<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Uses 'invisible=' syntax (Odoo 17+/19 compatible).
        No 'attrs=' used.
        Works on both Community and Enterprise.
    -->
    <record id="payment_provider_form_myfatoorah" model="ir.ui.view">
        <field name="name">payment.provider.form.myfatoorah</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="MyFatoorah Credentials"
                      name="myfatoorah_credentials"
                      invisible="code != 'myfatoorah'">
                    <group string="API Configuration" col="2">
                        <field name="myfatoorah_country"/>
                        <field name="myfatoorah_api_token" password="True"/>
                        <field name="myfatoorah_webhook_secret" password="True"/>
                    </group>
                    <group string="Features" col="2">
                        <field name="myfatoorah_enable_kfast"/>
                        <field name="myfatoorah_show_logos"/>
                        <field name="myfatoorah_send_invoice_email"/>
                        <field name="myfatoorah_cron_enabled"/>
                    </group>
                    <div class="mt-3">
                        <button name="action_test_myfatoorah_connection"
                                string="🔌 Test API Connection"
                                type="object"
                                class="btn btn-secondary"/>
                    </div>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
