<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Community-compatible provider record.
        Fields 'description', 'is_published', 'allow_tokenization' are Enterprise-only
        and intentionally omitted here for broad compatibility.
    -->
    <record id="payment_provider_myfatoorah" model="payment.provider">
        <field name="name">MyFatoorah</field>
        <field name="code">myfatoorah</field>
        <field name="state">disabled</field>
        <field name="sequence">10</field>
        <field name="myfatoorah_country">kw</field>
        <field name="myfatoorah_cron_enabled">True</field>
        <field name="myfatoorah_send_invoice_email">True</field>
        <field name="myfatoorah_show_logos">True</field>
    </record>

    <record id="payment_method_myfatoorah" model="payment.method">
        <field name="name">MyFatoorah</field>
        <field name="code">myfatoorah</field>
        <field name="sequence">10</field>
        <field name="active">True</field>
        <field name="support_tokenization">False</field>
        <field name="support_refund">partial</field>
        <field name="provider_ids" eval="[(4, ref('payment_myfatoorah.payment_provider_myfatoorah'))]"/>
    </record>
</odoo>
