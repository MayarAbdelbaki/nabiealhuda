<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_wholesale_price" model="ir.ui.view">
        <field name="name">product.template.form.wholesale.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="pos" position="inside">
                <field name="wholesale_price"
                    widget="monetary"
                    options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                <field name="wholesale_tax_ids"
                    widget="many2many_tax_tags"
                    context="{
                        'default_type_tax_use': 'sale',
                        'search_default_sale': 1,
                        'search_default_domestictax': 1,
                        'append_fields': ['company_id'],
                    }"/>
            </group>
        </field>
    </record>

</odoo>
