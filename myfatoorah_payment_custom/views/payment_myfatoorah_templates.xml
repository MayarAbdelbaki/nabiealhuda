<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Redirect form template for MyFatoorah.
        Referenced by payment.provider.redirect_form_view_id.

        Odoo 19's payment JS auto-submits the rendered form ONLY if it carries
        the `o_payment_redirect_form` class. MyFatoorah's InvoiceURL is a plain
        GET link, so an empty body with method="get" is sufficient.
    -->
    <template id="myfatoorah_redirect_form">
        <form t-att-action="api_url" method="get" class="o_payment_redirect_form"/>
    </template>

</odoo>
