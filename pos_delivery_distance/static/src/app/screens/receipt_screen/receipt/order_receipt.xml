<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Delivery orders collect a phone number on the delivery address popup
         (see DeliveryAddressPopup / action_pos_get_delivery_address) that can
         differ from the customer's own phone, so print it on the receipt to
         give the courier the right number to call. "before-footer" is the
         extension point core reserves for exactly this kind of addition. -->
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('before-footer')]" position="inside">
            <div t-if="order.partner_shipping_id?.phone" class="pos-receipt-order-data d-flex gap-2 pt-3">
                Delivery Phone:
                <span dir="ltr" t-out="order.partner_shipping_id.phone"/>
            </div>
        </xpath>
    </t>

</templates>
