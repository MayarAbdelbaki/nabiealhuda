<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_delivery_distance.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/button[hasclass('o_pricelist_button')]" position="before">
            <button t-if="showDeliveryButton and this.pos.cashier._role != 'minimal'"
                class="o_delivery_address_button"
                t-att-class="buttonClass"
                t-on-click="() => this.clickDelivery()">
                <i class="fa fa-truck me-1" role="img" aria-label="Delivery" title="Delivery" />
                <t t-if="currentOrder.partner_shipping_id" t-esc="currentOrder.partner_shipping_id.city || currentOrder.partner_shipping_id.name" />
                <t t-else="">Delivery</t>
            </button>
        </xpath>
    </t>
</templates>
