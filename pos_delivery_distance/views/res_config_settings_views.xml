<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_delivery_distance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="ship_later" position="after">
                <setting id="pos_distance_delivery" string="POS Delivery"
                         help="Let the cashier pick a delivery address in the POS and charge the delivery price on the order. Any Delivery Method can be used, not just distance-based ones.">
                    <div class="content-group mt16">
                        <div class="row">
                            <label for="pos_delivery_carrier_id" string="Delivery Method" class="col-lg-3 o_light_label"/>
                            <field name="pos_delivery_carrier_id" domain="[('available_in_pos', '=', True)]"/>
                        </div>
                        <div class="row">
                            <label for="pos_delivery_product_id" string="Delivery Product" class="col-lg-3 o_light_label"/>
                            <field name="pos_delivery_product_id"/>
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
