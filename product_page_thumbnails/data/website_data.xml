<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Product page image display: Carousel instead of Grid — one large
        image with prev/next arrows and thumbnail indicators to switch
        between the product's other Media images, rather than showing every
        image at once in a static grid.

        Equivalent to opening a product page in the website builder, clicking
        the main image block, and setting Images > Display to "Carousel" in
        the sidebar (see also the "Thumbnails: Left/Bottom" option there —
        left is Odoo's own default and is left untouched here).
    -->
    <record id="website.default_website" model="website">
        <field name="product_page_image_layout">carousel</field>
    </record>

</odoo>
