<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Small thumbnail strip appended below the product name / price / Add to
        Cart column, in addition to the large gallery already shown on the
        other side of the page. Reuses the exact same images as the main
        gallery (`(product_variant or product)._get_images()`, the same call
        `website_sale.shop_product_images` makes) and the same small
        `image_128` rendering already used for the carousel-layout indicator
        thumbnails, just relocated.
    -->
    <template id="product_page_thumbnails" inherit_id="website_sale.product">
        <xpath expr="//div[@id='product_details']" position="inside">
            <t t-set="thumbnail_images" t-value="(product_variant or product)._get_images()"/>
            <div t-if="thumbnail_images" class="o_product_page_thumbnails d-flex align-items-center gap-2 mt-3">
                <button
                    t-if="len(thumbnail_images) &gt; 1"
                    type="button"
                    class="o_product_page_thumbnails_prev btn btn-light btn-sm rounded-circle p-1 flex-shrink-0"
                    aria-label="Previous"
                    title="Previous"
                >
                    <i class="oi oi-chevron-left" role="img"/>
                </button>
                <div class="o_product_page_thumbnails_track d-flex gap-2">
                    <!--
                        data-bs-target/data-bs-slide-to are the same attributes
                        Odoo's own carousel indicators use — Bootstrap's
                        carousel picks up clicks on any element carrying them
                        (delegated at the document level), so no custom JS is
                        needed to switch the main image.
                    -->
                    <div
                        t-foreach="thumbnail_images" t-as="thumbnail_image"
                        t-attf-class="o_product_page_thumbnail_box {{'active' if thumbnail_image_first else ''}}"
                        role="button"
                        tabindex="0"
                        data-bs-target="#o-carousel-product"
                        t-att-data-bs-slide-to="thumbnail_image_index"
                    >
                        <div
                            t-field="thumbnail_image.image_128"
                            t-options="{
                                'widget': 'image',
                                'qweb_img_responsive': False,
                                'class': 'object-fit-cover w-100 h-100',
                                'alt-field': 'name',
                            }"
                        />
                    </div>
                </div>
                <button
                    t-if="len(thumbnail_images) &gt; 1"
                    type="button"
                    class="o_product_page_thumbnails_next btn btn-light btn-sm rounded-circle p-1 flex-shrink-0"
                    aria-label="Next"
                    title="Next"
                >
                    <i class="oi oi-chevron-right" role="img"/>
                </button>
            </div>
        </xpath>
    </template>

</odoo>
